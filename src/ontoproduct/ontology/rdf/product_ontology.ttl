@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix op: <urn:ontoproduct:ontology:> .
@prefix opqk: <urn:ontoproduct:ontology:quantitykind/> .
@prefix opsrc: <urn:ontoproduct:ontology:source/> .
@prefix opunit: <urn:ontoproduct:ontology:unit/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

op: a owl:Ontology ;
    rdfs:label "OntoProduct manufacturing product ontology" ;
    dcterms:source opsrc:goodrelations-1.0,
        opsrc:iof-202603,
        opsrc:qudt-3.5.2 ;
    owl:versionInfo "3.0.0" .

op:BLDCMotorItem a owl:Class ;
    rdfs:label "BLDCMotor physical item" ;
    rdfs:comment "Physical item of the BLDCMotor category; its model specification is represented separately." ;
    rdfs:subClassOf op:MotorItem ;
    op:applicationClass "BLDCMotor" .

op:BearingItem a owl:Class ;
    rdfs:label "Bearing physical item" ;
    rdfs:comment "Physical item of the Bearing category; its model specification is represented separately." ;
    rdfs:subClassOf op:MechanicalPartItem ;
    op:applicationClass "Bearing" .

op:ManufacturerOrganization a owl:Class ;
    rdfs:label "Manufacturer organization" ;
    dcterms:source opsrc:iof-202603 ;
    rdfs:comment "A manufacturer separately known to be an organization; never inferred from a name string." ;
    rdfs:subClassOf op:Manufacturer,
        op:Organization .

op:conversionMultiplier a owl:DatatypeProperty ;
    rdfs:domain op:Unit ;
    rdfs:range xsd:double .

op:conversionTargetUnit a owl:ObjectProperty ;
    rdfs:domain op:Unit ;
    rdfs:range op:Unit .

op:hasMakeAndModel a owl:ObjectProperty ;
    rdfs:label "Has make and model" ;
    dcterms:source opsrc:goodrelations-1.0 ;
    rdfs:comment "Connects an explicitly identified manufactured item to its catalog model." ;
    rdfs:domain op:ManufacturedItem ;
    rdfs:range op:ProductModel .

op:hasManufacturer a owl:ObjectProperty ;
    rdfs:label "Has manufacturer" ;
    dcterms:source opsrc:goodrelations-1.0 ;
    rdfs:comment "Connects a product model to its scoped manufacturer entity." ;
    rdfs:domain op:ProductModel ;
    rdfs:range op:Manufacturer ;
    op:applicationField "manufacturer" .

op:hasQuantityKind a owl:ObjectProperty ;
    rdfs:label "Has quantity kind" ;
    dcterms:source opsrc:qudt-3.5.2 ;
    rdfs:comment "Connects a quantity value to the kind of physical quantity it measures." ;
    rdfs:domain op:QuantityValue ;
    rdfs:range op:QuantityKind .

op:hasUnit a owl:ObjectProperty ;
    rdfs:label "Has unit" ;
    dcterms:source opsrc:qudt-3.5.2 ;
    rdfs:comment "Connects a quantity value to the unit of its numeric magnitude." ;
    rdfs:domain op:QuantityValue ;
    rdfs:range op:Unit .

op:measuresQuantityKind a owl:ObjectProperty ;
    rdfs:domain op:Unit ;
    rdfs:range op:QuantityKind .

op:numericValue a owl:DatatypeProperty ;
    rdfs:label "Numeric value" ;
    dcterms:source opsrc:qudt-3.5.2 ;
    rdfs:comment "The numeric magnitude of a quantity value, expressed in its stated unit." ;
    rdfs:domain op:QuantityValue .

op:symbol a owl:DatatypeProperty ;
    rdfs:domain op:Unit ;
    rdfs:range xsd:string .

opunit:g a op:Unit ;
    rdfs:label "gram" ;
    dcterms:source opsrc:qudt-3.5.2 ;
    op:conversionMultiplier 1e-03 ;
    op:conversionTargetUnit opunit:kg ;
    op:measuresQuantityKind opqk:mass ;
    op:symbol "g" .

opunit:kW a op:Unit ;
    rdfs:label "kilowatt" ;
    dcterms:source opsrc:qudt-3.5.2 ;
    op:conversionMultiplier 1e+03 ;
    op:conversionTargetUnit opunit:W ;
    op:measuresQuantityKind opqk:power ;
    op:symbol "kW" .

op:BusinessEntity a owl:Class ;
    rdfs:label "Business entity" ;
    dcterms:source opsrc:goodrelations-1.0 ;
    rdfs:comment "A party that makes, offers or supplies products or services. A name alone does not identify it globally." .

op:ElectricalPartItem a owl:Class ;
    rdfs:label "ElectricalPart physical item" ;
    rdfs:comment "Physical item of the ElectricalPart category; its model specification is represented separately." ;
    rdfs:subClassOf op:CatalogProductItem ;
    op:applicationClass "ElectricalPart" .

op:ElectricalPartModel a owl:Class ;
    rdfs:label "Electrical part model" ;
    rdfs:comment "Model of a component whose intended use involves electrical behavior." ;
    rdfs:subClassOf op:CatalogProductModel ;
    op:applicationClass "ElectricalPart" .

op:MechanicalPartItem a owl:Class ;
    rdfs:label "MechanicalPart physical item" ;
    rdfs:comment "Physical item of the MechanicalPart category; its model specification is represented separately." ;
    rdfs:subClassOf op:CatalogProductItem ;
    op:applicationClass "MechanicalPart" .

op:MechanicalPartModel a owl:Class ;
    rdfs:label "Mechanical part model" ;
    rdfs:comment "Model of a component whose intended use primarily involves mechanical behavior." ;
    rdfs:subClassOf op:CatalogProductModel ;
    op:applicationClass "MechanicalPart" .

op:MotorItem a owl:Class ;
    rdfs:label "Motor physical item" ;
    rdfs:comment "Physical item of the Motor category; its model specification is represented separately." ;
    rdfs:subClassOf op:ElectricalPartItem ;
    op:applicationClass "Motor" .

op:MotorModel a owl:Class ;
    rdfs:label "Motor model" ;
    rdfs:comment "Model of an electrical component intended to convert electrical energy into mechanical motion." ;
    rdfs:subClassOf op:ElectricalPartModel ;
    op:applicationClass "Motor" .

op:Organization a owl:Class ;
    rdfs:label "Organization" ;
    dcterms:source opsrc:iof-202603 ;
    rdfs:comment "An entity separately known to be an organized group with a shared purpose; never inferred from a name string." .

op:PhysicalArtifact a owl:Class ;
    rdfs:label "Physical artifact" ;
    dcterms:source opsrc:iof-202603 ;
    rdfs:comment "A material object produced by intentional human activity. Upper concept for identified physical items." .

op:innerDiameter a owl:ObjectProperty ;
    rdfs:label "Bearing inner diameter" ;
    rdfs:comment "Nominal diameter of the bearing bore." ;
    rdfs:domain op:BearingModel ;
    rdfs:range op:QuantityValue ;
    op:applicationField "inner_diameter" ;
    op:canonicalUnit opunit:mm ;
    op:quantityKind opqk:length .

op:mass a owl:ObjectProperty ;
    rdfs:label "Product mass" ;
    rdfs:comment "The legacy weight field means mass in kg, not gravitational force or weight in newtons." ;
    rdfs:domain op:BLDCMotorModel ;
    rdfs:range op:QuantityValue ;
    op:applicationField "weight" ;
    op:canonicalUnit opunit:kg ;
    op:quantityKind opqk:mass .

op:outerDiameter a owl:ObjectProperty ;
    rdfs:label "Bearing outer diameter" ;
    rdfs:comment "Nominal outside diameter, required to exceed the inner diameter for this registration profile." ;
    rdfs:domain op:BearingModel ;
    rdfs:range op:QuantityValue ;
    op:applicationField "outer_diameter" ;
    op:canonicalUnit opunit:mm ;
    op:quantityKind opqk:length .

op:ratedPower a owl:ObjectProperty ;
    rdfs:label "Rated power" ;
    rdfs:comment "Rated power specified in the source. Input versus shaft output power is not inferred without explicit evidence." ;
    rdfs:domain op:BLDCMotorModel ;
    rdfs:range op:QuantityValue ;
    op:applicationField "rated_power" ;
    op:canonicalUnit opunit:W ;
    op:quantityKind opqk:power .

op:ratedSpeed a owl:ObjectProperty ;
    rdfs:label "Rated shaft speed" ;
    rdfs:comment "Manufacturer-specified shaft revolutions per time, modeled as rotational frequency and kept in rpm locally." ;
    rdfs:domain op:BLDCMotorModel ;
    rdfs:range op:QuantityValue ;
    op:applicationField "rated_speed" ;
    op:canonicalUnit opunit:rpm ;
    op:quantityKind opqk:rotational_frequency .

op:ratedVoltage a owl:ObjectProperty ;
    rdfs:label "Rated voltage" ;
    rdfs:comment "Manufacturer-specified operating voltage for the model, expressed as a quantity value." ;
    rdfs:domain op:BLDCMotorModel ;
    rdfs:range op:QuantityValue ;
    op:applicationField "rated_voltage" ;
    op:canonicalUnit opunit:V ;
    op:quantityKind opqk:electric_potential .

op:BearingModel a owl:Class ;
    rdfs:label "Bearing model" ;
    rdfs:comment "Model of a mechanical component supporting relative motion, registered with inner and outer diameters." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom op:QuantityValue ;
            owl:onProperty op:innerDiameter ],
        [ a owl:Restriction ;
            owl:allValuesFrom op:QuantityValue ;
            owl:onProperty op:outerDiameter ],
        op:MechanicalPartModel ;
    op:applicationClass "Bearing" .

op:CatalogProductItem a owl:Class ;
    rdfs:label "Product physical item" ;
    rdfs:comment "Physical item of the Product category; its model specification is represented separately." ;
    rdfs:subClassOf op:ManufacturedItem ;
    op:applicationClass "Product" .

op:CatalogProductModel a owl:Class ;
    rdfs:label "Manufactured product model" ;
    rdfs:comment "Root application profile for catalog model registration." ;
    rdfs:subClassOf op:ProductModel ;
    op:applicationClass "Product" .

op:Manufacturer a owl:Class ;
    rdfs:label "Manufacturer entity" ;
    dcterms:source opsrc:goodrelations-1.0 ;
    rdfs:comment "A business entity responsible for producing a model; a name alone does not identify it globally." ;
    rdfs:subClassOf op:BusinessEntity .

opqk:electric_potential a op:QuantityKind ;
    rdfs:label "Electric potential difference" ;
    dcterms:source opsrc:qudt-3.5.2 ;
    rdfs:comment "Voltage between two points; used for rated voltage." ;
    op:siDimensions "{\"current\": -1, \"length\": 2, \"mass\": 1, \"time\": -3}" .

opqk:rotational_frequency a op:QuantityKind ;
    rdfs:label "Rotational frequency" ;
    dcterms:source opsrc:qudt-3.5.2 ;
    rdfs:comment "Revolutions of a rotating shaft per unit time; kept in rpm and not converted to angular velocity in rad/s." ;
    op:siDimensions "{\"time\": -1}" .

opunit:V a op:Unit ;
    rdfs:label "volt" ;
    dcterms:source opsrc:qudt-3.5.2 ;
    op:conversionMultiplier 1e+00 ;
    op:conversionTargetUnit opunit:V ;
    op:measuresQuantityKind opqk:electric_potential ;
    op:symbol "V" .

opunit:rpm a op:Unit ;
    rdfs:label "revolution per minute" ;
    dcterms:source opsrc:qudt-3.5.2 ;
    op:conversionMultiplier 1e+00 ;
    op:conversionTargetUnit opunit:rpm ;
    op:measuresQuantityKind opqk:rotational_frequency ;
    op:symbol "rpm" .

op:ManufacturedItem a owl:Class ;
    rdfs:label "Manufactured physical item" ;
    dcterms:source opsrc:goodrelations-1.0,
        opsrc:iof-202603 ;
    rdfs:comment "An explicitly identified individual physical artifact; a catalog entry does not establish its existence." ;
    rdfs:subClassOf op:PhysicalArtifact .

op:ProductModel a owl:Class ;
    rdfs:label "Product model" ;
    dcterms:source opsrc:goodrelations-1.0 ;
    rdfs:comment "A catalog specification for a manufactured product model, not an individual physical item." ;
    owl:disjointWith op:ManufacturedItem .

op:SourceRecord a owl:Class ;
    rdfs:label "Design source record" ;
    rdfs:comment "Local record of an outside work used as a design reference." .

opqk:length a op:QuantityKind ;
    rdfs:label "Length" ;
    dcterms:source opsrc:qudt-3.5.2 ;
    rdfs:comment "A linear dimension such as a bearing diameter." ;
    op:siDimensions "{\"length\": 1}" .

opqk:mass a op:QuantityKind ;
    rdfs:label "Mass" ;
    dcterms:source opsrc:qudt-3.5.2 ;
    rdfs:comment "Amount of matter, in kilograms; not gravitational force." ;
    op:siDimensions "{\"mass\": 1}" .

opqk:power a op:QuantityKind ;
    rdfs:label "Power" ;
    dcterms:source opsrc:qudt-3.5.2 ;
    rdfs:comment "Rate of energy transfer. Input versus shaft output power is not distinguished without explicit evidence." ;
    op:siDimensions "{\"length\": 2, \"mass\": 1, \"time\": -3}" .

opunit:W a op:Unit ;
    rdfs:label "watt" ;
    dcterms:source opsrc:qudt-3.5.2 ;
    op:conversionMultiplier 1e+00 ;
    op:conversionTargetUnit opunit:W ;
    op:measuresQuantityKind opqk:power ;
    op:symbol "W" .

opunit:kg a op:Unit ;
    rdfs:label "kilogram" ;
    dcterms:source opsrc:qudt-3.5.2 ;
    op:conversionMultiplier 1e+00 ;
    op:conversionTargetUnit opunit:kg ;
    op:measuresQuantityKind opqk:mass ;
    op:symbol "kg" .

opunit:mm a op:Unit ;
    rdfs:label "millimetre" ;
    dcterms:source opsrc:qudt-3.5.2 ;
    op:conversionMultiplier 1e+00 ;
    op:conversionTargetUnit opunit:mm ;
    op:measuresQuantityKind opqk:length ;
    op:symbol "mm" .

op:BLDCMotorModel a owl:Class ;
    rdfs:label "Brushless DC motor model" ;
    rdfs:comment "Model of a brushless electronically commutated DC motor. Numeric specifications alone do not prove brushless construction." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom op:QuantityValue ;
            owl:onProperty op:mass ],
        [ a owl:Restriction ;
            owl:allValuesFrom op:QuantityValue ;
            owl:onProperty op:ratedPower ],
        [ a owl:Restriction ;
            owl:allValuesFrom op:QuantityValue ;
            owl:onProperty op:ratedVoltage ],
        [ a owl:Restriction ;
            owl:allValuesFrom op:QuantityValue ;
            owl:onProperty op:ratedSpeed ],
        op:MotorModel ;
    op:applicationClass "BLDCMotor" .

opsrc:iof-202603 a op:SourceRecord ;
    dcterms:creator "IOF Core Working Group / Industrial Ontologies Foundry / Open Applications Group" ;
    dcterms:license "MIT" ;
    dcterms:title "IOF Core ontology" ;
    rdfs:comment "Design reference for physical artifacts and organizations. Definitions here are project-authored." ;
    owl:versionInfo "202603" .

op:QuantityKind a owl:Class ;
    rdfs:label "Quantity kind" ;
    dcterms:source opsrc:qudt-3.5.2 ;
    rdfs:comment "A kind of measurable physical quantity, such as power or length, described by its SI base dimensions." .

opsrc:goodrelations-1.0 a op:SourceRecord ;
    dcterms:creator "Martin Hepp" ;
    dcterms:license "CC-BY-3.0" ;
    dcterms:title "GoodRelations vocabulary" ;
    rdfs:comment "Design reference for product models, business entities and model-item links. Definitions here are project-authored." ;
    owl:versionInfo "1.0, release 2011-10-01" .

op:Unit a owl:Class ;
    rdfs:label "Unit of measure" ;
    dcterms:source opsrc:qudt-3.5.2 ;
    rdfs:comment "A unit in which one quantity kind is expressed, with a conversion multiplier to the project canonical unit." .

op:QuantityValue a owl:Class ;
    rdfs:label "Quantity value" ;
    dcterms:source opsrc:qudt-3.5.2 ;
    rdfs:comment "A value node holding exactly one numeric magnitude together with its unit and quantity kind." .

opsrc:qudt-3.5.2 a op:SourceRecord ;
    dcterms:creator "QUDT.org" ;
    dcterms:license "CC-BY-4.0" ;
    dcterms:title "QUDT quantities, units and dimensions" ;
    rdfs:comment "Design reference for quantity values, quantity kinds and units. Definitions and conversion multipliers here are project-authored." ;
    owl:versionInfo "3.5.2" .

