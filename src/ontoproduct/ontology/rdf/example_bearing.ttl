@prefix op: <urn:ontoproduct:ontology:> .
@prefix opqk: <urn:ontoproduct:ontology:quantitykind/> .
@prefix opunit: <urn:ontoproduct:ontology:unit/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:ontoproduct:record:bearing> a op:BearingModel,
        op:CatalogProductModel,
        op:MechanicalPartModel,
        op:ProductModel ;
    rdfs:label "BR-6201" ;
    op:attributeEvidence <urn:ontoproduct:record:bearing:attribute:inner_diameter>,
        <urn:ontoproduct:record:bearing:attribute:outer_diameter> ;
    op:innerDiameter <urn:ontoproduct:record:bearing:value:inner_diameter> ;
    op:outerDiameter <urn:ontoproduct:record:bearing:value:outer_diameter> .

<urn:ontoproduct:record:bearing:value:inner_diameter> a op:QuantityValue ;
    op:attributeEvidence <urn:ontoproduct:record:bearing:attribute:inner_diameter> ;
    op:hasQuantityKind opqk:length ;
    op:hasUnit opunit:mm ;
    op:numericValue 12 .

<urn:ontoproduct:record:bearing:value:outer_diameter> a op:QuantityValue ;
    op:attributeEvidence <urn:ontoproduct:record:bearing:attribute:outer_diameter> ;
    op:hasQuantityKind opqk:length ;
    op:hasUnit opunit:mm ;
    op:numericValue 32 .

<urn:ontoproduct:record:bearing:attribute:inner_diameter> op:applicationField "inner_diameter" ;
    op:candidateEvidence [ op:confidence 8.5e-01 ;
            op:evidence "[Sheet: Spec, Row: 3] A3=Inner Diameter | B3=12 mm" ;
            op:provenance "AI" ;
            op:source_file "bearing.xlsx" ;
            op:unit "mm" ;
            op:value 12 ] ;
    op:hasConflict false ;
    op:recordJSON "{\"value\": 12, \"unit\": \"mm\", \"confidence\": 0.85, \"evidence\": \"[Sheet: Spec, Row: 3] A3=Inner Diameter | B3=12 mm\", \"source_file\": \"bearing.xlsx\", \"page\": null, \"provenance\": \"AI\"}" .

<urn:ontoproduct:record:bearing:attribute:outer_diameter> op:applicationField "outer_diameter" ;
    op:candidateEvidence [ op:confidence 8.5e-01 ;
            op:evidence "[Sheet: Spec, Row: 4] A4=Outer Diameter | B4=32 mm" ;
            op:provenance "AI" ;
            op:source_file "bearing.xlsx" ;
            op:unit "mm" ;
            op:value 32 ] ;
    op:hasConflict false ;
    op:recordJSON "{\"value\": 32, \"unit\": \"mm\", \"confidence\": 0.85, \"evidence\": \"[Sheet: Spec, Row: 4] A4=Outer Diameter | B4=32 mm\", \"source_file\": \"bearing.xlsx\", \"page\": null, \"provenance\": \"AI\"}" .

